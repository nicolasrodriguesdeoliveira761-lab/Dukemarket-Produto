<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="595.0" prefWidth="866.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="br.dev.nicolas.dukemarket.graphic.controller.ScrProdutosController">
   <children>
      <AnchorPane layoutY="-1.0" prefHeight="370.0" prefWidth="872.0">
         <children>
            <TableView fx:id="tblProduto" layoutX="10.0" layoutY="10.0" onMouseClicked="#tblProdutoOnMouseClicked" prefHeight="351.0" prefWidth="853.0">
              <columns>
                <TableColumn fx:id="tcoId" prefWidth="75.0" text="ID" />
                <TableColumn fx:id="tcoCodBarras" prefWidth="75.0" text="Cod.Barras" />
                  <TableColumn fx:id="tcoDescricao" prefWidth="351.0" text="Descrição" />
                  <TableColumn fx:id="tcoQtd" minWidth="0.0" prefWidth="81.0" text="Qtd." />
                  <TableColumn fx:id="tcoValorCompra" minWidth="0.0" prefWidth="94.0" text="\$ Compra" />
                  <TableColumn fx:id="tcoValorVenda" prefWidth="75.0" text="\$ Venda" />
                  <TableColumn fx:id="tcoDataCadastro" prefWidth="101.0" text="Data Cadastro" />
              </columns>
            </TableView>
         </children>
      </AnchorPane>
      <AnchorPane layoutY="370.0" prefHeight="225.0" prefWidth="559.0">
         <children>
            <Label layoutX="255.0" layoutY="80.0" text="Valor Compra" />
            <TextField fx:id="txtValorCompra" layoutX="344.0" layoutY="75.0" prefHeight="25.0" prefWidth="165.0" />
            <TextField fx:id="txtDescricao" layoutX="109.0" layoutY="45.0" prefHeight="25.0" prefWidth="400.0" />
            <TextField fx:id="txtCodBarras" layoutX="344.0" layoutY="14.0" prefHeight="25.0" prefWidth="165.0" />
            <Label layoutX="255.0" layoutY="18.0" text="Cod.Barras" />
            <TextField fx:id="txtId" layoutX="109.0" layoutY="14.0" prefHeight="25.0" prefWidth="103.0" />
            <TextField fx:id="txtQtd" layoutX="109.0" layoutY="76.0" prefHeight="25.0" prefWidth="74.0" />
            <TextField fx:id="txtValorVenda" layoutX="109.0" layoutY="108.0" prefHeight="25.0" prefWidth="165.0" />
            <DatePicker fx:id="dtpDataCadastro" layoutX="109.0" layoutY="140.0" prefHeight="25.0" prefWidth="189.0" />
            <Label layoutX="15.0" layoutY="144.0" text="Data Cadastro" />
            <Label layoutX="14.0" layoutY="112.0" text="Valor Venda" />
            <Label layoutX="14.0" layoutY="80.0" text="Qtd." />
            <Label layoutX="16.0" layoutY="49.0" text="Descrição" />
            <Label layoutX="18.0" layoutY="18.0" text="ID" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="561.0" layoutY="370.0" prefHeight="225.0" prefWidth="311.0">
         <children>
            <Button fx:id="btnNovo" layoutX="31.0" layoutY="88.0" mnemonicParsing="false" onAction="#btnNovoClick" prefHeight="25.0" prefWidth="250.0" text="Novo" />
            <Button fx:id="btnSalvar" layoutX="31.0" layoutY="121.0" mnemonicParsing="false" onAction="#btnSalvarClick" prefHeight="25.0" prefWidth="250.0" text="Salvar" />
            <Button fx:id="btnExcluir" layoutX="31.0" layoutY="153.0" mnemonicParsing="false" onAction="#btnExcluirClick" prefHeight="25.0" prefWidth="250.0" text="Excluir" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
